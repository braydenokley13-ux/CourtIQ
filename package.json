{
  "name": "courtiq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "build": "pnpm content:materialize && turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "content:materialize": "node --import tsx scripts/materialize-content.ts",
    "content:check": "node --import tsx scripts/materialize-content.ts --check",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@courtiq/basketball": "workspace:*",
    "@playwright/test": "^1.59.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
