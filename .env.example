# Optional canonical origin for metadata, robots and sitemap.
# Build and runtime need no backend credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable internal world/athlete review routes in a production QA server only.
# Public deployments leave this unset.
ENABLE_DEV_ROUTES=

# Vercel build-tool setting: retain ENABLE_EXPERIMENTAL_COREPACK=1 on the
# project to honor packageManager's exact pnpm version. It is unnecessary
# when local/CI tooling already supplies pnpm 9.15.0.
